{
  "name": "@tessera-kit/editor",
  "version": "0.2.0",
  "description": "Rich-text editor kit for Tessera: a headless API, a <tessera-editor> web component and React bindings",
  "license": "MIT",
  "author": "Abhishek Thakur",
  "type": "module",
  "sideEffects": [
    "./dist/autoload.js",
    "./dist/elements/**/*.js",
    "./src/autoload.ts",
    "./src/elements/**/*.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./autoload": {
      "types": "./dist/autoload.d.ts",
      "import": "./dist/autoload.js"
    },
    "./elements": {
      "types": "./dist/elements/index.d.ts",
      "import": "./dist/elements/index.js"
    },
    "./elements/*": {
      "types": "./dist/elements/tags/*.d.ts",
      "import": "./dist/elements/tags/*.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@tiptap/core": "^3.31.0",
    "@tiptap/extension-character-count": "^3.31.0",
    "@tiptap/extension-code-block-lowlight": "^3.31.0",
    "@tiptap/extension-highlight": "^3.31.0",
    "@tiptap/extension-image": "^3.31.0",
    "@tiptap/extension-mention": "^3.31.0",
    "@tiptap/extension-placeholder": "^3.31.0",
    "@tiptap/extension-table": "^3.31.0",
    "@tiptap/extension-task-item": "^3.31.0",
    "@tiptap/extension-task-list": "^3.31.0",
    "@tiptap/extension-text-align": "^3.31.0",
    "@tiptap/extension-typography": "^3.31.0",
    "@tiptap/markdown": "^3.31.0",
    "@tiptap/pm": "^3.31.0",
    "@tiptap/starter-kit": "^3.31.0",
    "@tiptap/suggestion": "^3.31.0",
    "dompurify": "^3.4.0",
    "lit": "^3.3.0",
    "lowlight": "^3.3.0",
    "zod": "^4.2.0"
  },
  "peerDependencies": {
    "@tessera-kit/core": "^0.1.0",
    "@tessera-kit/elements": "^0.1.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@tessera-internal/react-wrap": "workspace:*",
    "@tessera-internal/test-utils": "workspace:*",
    "@tessera-kit/core": "^0.1.0",
    "@tessera-kit/elements": "^0.1.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.3",
    "playwright": "^1.63.0",
    "react": "^19",
    "react-dom": "^19.3.0"
  }
}
